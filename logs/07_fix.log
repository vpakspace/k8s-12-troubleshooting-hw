$ diff -u --label task.yaml --label fixed.yaml manifests/task.yaml manifests/fixed.yaml
--- task.yaml
+++ fixed.yaml
@@ -1,3 +1,19 @@
+# Исправленный вариант manifests/task.yaml (исходный файл не менялся).
+# Применять на чистом кластере: kubectl apply -f manifests/fixed.yaml
+# Изменения помечены комментариями «# FIX N».
+---
+# FIX 1. В исходном task.yaml нет Namespace'ов, а объекты в них лежат —
+# kubectl apply падал с «namespaces "web" not found» / «namespaces "data" not found».
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: web
+---
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: data
+---
 apiVersion: apps/v1
 kind: Deployment
 metadata:
@@ -17,8 +33,14 @@
       - command:
         - sh
         - -c
-        - while true; do curl auth-db; sleep 5; done
-        image: radial/busyboxplus:curl
+        # FIX 3 (главное). Было: curl auth-db
+        # Короткое имя «auth-db» DNS дополняет доменом СВОЕГО namespace (web.svc.cluster.local),
+        # а Service лежит в namespace data. Поэтому — полное имя <service>.<namespace>.svc.cluster.local.
+        - while true; do curl auth-db.data.svc.cluster.local; sleep 5; done
+        # FIX 2 (стенд). Было: radial/busyboxplus:curl — образ в формате Docker manifest schema 1,
+        # containerd v2.1.6 на этой VM такой образ не принимает («schema 1 image manifests are no longer
+        # supported»). curlimages/curl — тот же curl в современном формате; команда выше переопределяет ENTRYPOINT.
+        image: curlimages/curl:8.11.1
         name: busybox
 ---
 apiVersion: apps/v1

$ kubectl apply -f manifests/fixed.yaml
namespace/web unchanged
namespace/data unchanged
deployment.apps/web-consumer configured
deployment.apps/auth-db unchanged
service/auth-db unchanged

$ kubectl rollout status deployment/web-consumer -n web --timeout=120s | tail -1
deployment "web-consumer" successfully rolled out

